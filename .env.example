# Project URL comes from Supabase Project Connect settings.
EXPO_PUBLIC_SUPABASE_URL=

# Publishable key is client-safe when RLS is configured.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local application URL and authentication callback path
EXPO_PUBLIC_APP_URL=http://localhost:8081
EXPO_PUBLIC_AUTH_CALLBACK_PATH=/auth/callback

# Optional secure Edge Function name for AR Scan structured analysis.
# Leave blank during local development to use clearly marked mock results.
EXPO_PUBLIC_AR_SCAN_ENDPOINT=

# Optional secure Edge Function name for Calorie Tracker food-image analysis.
# Leave blank during local development to use clearly marked mock results.
EXPO_PUBLIC_CALORIE_SCAN_ENDPOINT=

# Optional local E2E test settings. Do not commit real credentials.
ELEVENLABS_E2E_EMAIL=
ELEVENLABS_E2E_PASSWORD=
ELEVENLABS_E2E_ARTIFACTS_DIR=

# =========================================================================
# IMPORTANT SECURITY WARNINGS:
# - Service-role and database credentials must never be added here.
# - GEMINI_API_KEY is server-only and belongs in Supabase Edge Function secrets.
# - Every EXPO_PUBLIC value is visible in the application bundle.
# =========================================================================
